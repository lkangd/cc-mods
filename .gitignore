# Local Claude Code launch state
.claude/.ccsp/

# Code review run packets
.code-review/

# Test evidence
mods/*/build/evidence/
mods/*/build/pty-runs/

# Python test caches
__pycache__/
*.py[cod]

# Handoff documents for the next session (local only)
docs/handoffs/

# local todo list
docs/todos/

# Shared notes of parallel implementers (local only)
.scratch/*/notes/

# Probe captures: per-step screens and host debug logs stay local; steps.json and the probes' own logs are tracked
.scratch/*/assets/*/runs/**/[0-9][0-9][0-9]-*.txt
.scratch/*/assets/*/runs/**/debug.log
.scratch/*/assets/*/runs/**/latest

# Promo code
promo/