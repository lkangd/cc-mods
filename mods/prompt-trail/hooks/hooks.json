{
  "description": "Prompt Trail function hooks and lifecycle bridge",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/prompt-trail-bridge\" publish \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/bin/prompt-trail-helper\" \"${CLAUDE_PLUGIN_ROOT}/artifacts/helper-manifest.json\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/prompt-trail-bridge\" remove \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\" \"${CLAUDE_PLUGIN_ROOT}/bin/prompt-trail-helper\" \"${CLAUDE_PLUGIN_ROOT}/artifacts/helper-manifest.json\""
          }
        ]
      }
    ]
  },
  "modules": ["./register.tsx"]
}
